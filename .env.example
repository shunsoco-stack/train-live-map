# ODPT(公共交通オープンデータセンター)接続設定のテンプレート。
# このファイルをコピーして .env.local を作成し、値を設定してください。
#
#   cp .env.example .env.local
#
# .env.local は .gitignore 済みで、コミットされません。
# アクセストークンは絶対にコミットしないでください。

# 開発者サイト(https://developer.odpt.org/)でチャレンジ2026へエントリー後に
# 発行されたチャレンジ用アクセストークン(必須)
# 未設定の場合はモックデータで動作します。
ODPT_ACCESS_TOKEN=

# 利用者による運行状況投票の共有保存先（Upstash Redis / Vercel KV）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push通知。web-push generate-vapid-keys で1組だけ生成し、
# 秘密鍵はVercelのSensitive環境変数として管理してください。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:train-live-map-support@gmail.com

# 以下は任意。未設定なら既定値が使われます。

# API ベース URL(既定: https://api-challenge.odpt.org/api/v4)
# ODPT_API_BASE_URL=https://api-challenge.odpt.org/api/v4

# 対象路線 odpt:railway(既定: odpt.Railway:JR-East.Tokaido)
# ODPT_RAILWAY=odpt.Railway:JR-East.Tokaido

# 対象事業者 odpt:operator(既定: odpt.Operator:JR-East)
# ODPT_OPERATOR=odpt.Operator:JR-East

# リクエストのタイムアウト(ミリ秒, 既定: 8000)
# ODPT_TIMEOUT_MS=8000

# リトライ回数(既定: 2)
# ODPT_RETRIES=2

# Google AdSense（両方を設定した場合のみ、画面下部に広告枠を表示）
# AdSense のサイト確認だけを先に行う場合は CLIENT のみ設定できます。
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1234567890123456
# NEXT_PUBLIC_ADSENSE_BANNER_SLOT=1234567890

# Recommended: dedicated 32+ character server-only HMAC secret for anonymous
# vote and push-setting abuse prevention. Never expose it as NEXT_PUBLIC_*.
COMMUNITY_REPORT_HMAC_SECRET=

# Canonical public origin used for metadata. Must be HTTPS in production.
NEXT_PUBLIC_SITE_URL=https://train-live-map.vercel.app
